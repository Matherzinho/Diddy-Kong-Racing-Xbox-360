+    normalized.active[MDKR_CONTROLLER_SOURCE_RIGHT_STICK_UP] = st.thumb_ry > 12000;
+    normalized.active[MDKR_CONTROLLER_SOURCE_RIGHT_STICK_DOWN] = st.thumb_ry < -12000;
