+    { "NO CHEAT", "SEM TRAPA$A" }, { "THIS TIME.", "ESSE TEMPO." },
+    { "1st", "1*" }, { "2nd", "2*" }, { "3rd", "3*" }, { "4th", "4*" }, { "5th", "5*" }, { "6th", "6*" },
+    { "7th", "7*" }, { "8th", "8*" }, { "1ST", "1*" }, { "2ND", "2*" }, { "3RD", "3*" }, { "4TH", "4*" },
+    { "5TH", "5*" }, { "6TH", "6*" }, { "7TH", "7*" }, { "8TH", "8*" },
+    { "CAN'T", "N@AO PODE" }, { "SAVE", "SALVAR" }, { "GHOST", "FANTASMA" }, { " CONTROLLER", " CONTROLE" },
+    { "PAK", "PAK EST(A" }, { "FULL", "CHEIO" }, { "DAMAGED", "DANIFICADO" },
+    { "RACE", "CORRIDA" }, { "LAP", "VOLTA" }, { "DID NOT FINISH", "N@AO TERMINOU" },
+};
+const char *mdkr_pt_text(const char *text) {
+    size_t i;
+    if (!gMdkrPtBr || text == NULL || text[0] == '\0') {
+        return text;
+    }
+    for (i = 0; i < sizeof(kPtBrText) / sizeof(kPtBrText[0]); i++) {
+        if (kPtBrText[i][0][0] == text[0] && strcmp(kPtBrText[i][0], text) == 0) {
+            return kPtBrText[i][1];
+        }
+    }
+    return text;
+}
