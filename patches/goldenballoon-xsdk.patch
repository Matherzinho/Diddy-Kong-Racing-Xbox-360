+static int dkr360_xam_axis(int v) {
+    /* XInput's own dead zone (7849 of 32767), then the N64's +/-80 */
+    const int dead = 7849;
+    int out;
+    if (v > -dead && v < dead) return 0;
+    out = v > 0 ? (v - dead) * STICK_FULL / (32767 - dead) : (v + dead) * STICK_FULL / (32768 - dead);
+    if (out < -STICK_FULL) out = -STICK_FULL;
+    if (out > STICK_FULL) out = STICK_FULL;
+    return out;
