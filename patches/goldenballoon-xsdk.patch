+extern uint32_t XamInputGetState(uint32_t user_index, uint32_t flags, void *state);
+
+static int dkr360_xam_state(int port, Dkr360XamState *st) {
+    memset(st, 0, sizeof(*st));
+    return XamInputGetState((uint32_t)port, 0, st) == 0;
