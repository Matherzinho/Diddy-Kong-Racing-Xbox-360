+    normalized.active[MDKR_CONTROLLER_SOURCE_B] = (st.buttons & 0x2000) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_X] = (st.buttons & 0x4000) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_Y] = (st.buttons & 0x8000) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_START] = (st.buttons & 0x0010) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_LEFT_STICK] = (st.buttons & 0x0040) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_RIGHT_STICK] = (st.buttons & 0x0080) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_LEFT_SHOULDER] = (st.buttons & 0x0100) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_RIGHT_SHOULDER] = (st.buttons & 0x0200) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_DPAD_UP] = (st.buttons & 0x0001) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_DPAD_DOWN] = (st.buttons & 0x0002) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_DPAD_LEFT] = (st.buttons & 0x0004) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_DPAD_RIGHT] = (st.buttons & 0x0008) != 0;
+    normalized.active[MDKR_CONTROLLER_SOURCE_LEFT_TRIGGER] = st.left_trigger > 30;
+    normalized.active[MDKR_CONTROLLER_SOURCE_RIGHT_TRIGGER] = st.right_trigger > 30;
