+#ifdef NATIVE_PORT
+/* dkr360: how far into the arena the main pool's live blocks reach, in bytes from its start (0: not known). The
+ * pool's allocator is best-fit, so its free tail stays the last block taken and the live ones gather low; the
+ * presentation replay's arena copy (gfx_retained_task.c) needs only this much on the Xbox 360, where copying all 16 MB
+ * every authored frame costs some 9 ms. */
+size_t mdkr_mempool_main_used_bytes(void) {
+    const MemoryPool *pool;
+    const u8 *base;
+    uintptr_t highest = 0;
+    s32 i;
+
+    if (gNumberOfMemoryPools < 0 || gMemoryPools[0].slots == NULL) {
+        return 0;
+    }
+    pool = &gMemoryPools[0];
+    base = (const u8 *) pool->slots;
+    /* The blocks in use, along the pool's list as mempool_slot_find walks it (entries past curNumSlots are not
+     * blocks); a list longer than the slots is a broken one: not known. */
+    i = 0;
+    for (s32 walked = 0; i != MEMSLOT_NONE; walked++) {
+        const MemoryPoolSlot *slot;
+        if (walked > pool->maxNumSlots || i < 0 || i >= pool->maxNumSlots) {
+            return 0;
+        }
+        slot = &pool->slots[i];
+        if (slot->flags != SLOT_FREE && slot->data != NULL && slot->size > 0) {
+            const uintptr_t end = (uintptr_t) (slot->data + slot->size) - (uintptr_t) base;
+            if (end > highest) {
+                highest = end;
+            }
+        }
+        i = slot->nextIndex;
+    }
+    return (size_t) highest;
+}
+#endif
